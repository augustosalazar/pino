# R_PINE App Environment Variables - SAMPLE
# Copy this file to .env and fill in your actual values
# WARNING: Never commit .env to version control!

# Roble Auth API Configuration
EXPO_PUBLIC_ROBLE_PROJECT_ID=your_project_id_here
EXPO_PUBLIC_ROBLE_BASE_URL=https://roble-api.openlab.uninorte.edu.co

# Pine Server API Configuration  
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Notes:
# - Use EXPO_PUBLIC_ prefix for variables accessible in your app
# - For iOS Simulator/Web: http://localhost:8000/api
# - For Android Emulator: http://10.0.2.2:8000/api
# - For Physical Device: http://YOUR_COMPUTER_IP:8000/api
