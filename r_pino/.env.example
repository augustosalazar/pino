# Expo Public Environment Variables
# These variables are prefixed with EXPO_PUBLIC_ and will be:
# 1. Accessible in your React code via process.env.EXPO_PUBLIC_*
# 2. Baked into the JavaScript bundle at BUILD time (not runtime)
# 3. Visible to users in the browser (don't put secrets here!)

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:8000

# Roble Authentication Service
EXPO_PUBLIC_ROBLE_PROJECT_ID=your-project-id
EXPO_PUBLIC_ROBLE_BASE_URL=http://localhost:3001

# Feature Flags (optional)
# EXPO_PUBLIC_ENABLE_ANALYTICS=false
# EXPO_PUBLIC_DEBUG_MODE=true

# ============================================
# IMPORTANT NOTES:
# ============================================
# 1. Create .env.local for local development (gitignored)
# 2. Create .env.production for production values
# 3. Or pass via Docker build args (see docker-compose.yml)
# 4. NEVER commit actual values to git
# 5. NEVER put API keys/secrets in EXPO_PUBLIC_ variables
